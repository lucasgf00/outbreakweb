# /etc/reo/alerts.env on the VPS (0600 root). NEVER commit the real file: a webhook URL is a secret
# (anyone with it can post to the channel). Fill it with: deploy.sh rotate alerts (asks on stdin).
# reo-activate creates this file empty if it is missing and never overwrites it.
#
# Staff alerts channel (reo-alert: failures, recoveries, reminders).
REO_ALERT_WEBHOOK=
# Staff reports channel (the server posts player and bug reports here). reo-server gets it as an environment
# variable through EnvironmentFile in its unit, so a change needs a restart of reo-server.
REO_REPORT_WEBHOOK=
#
# Optional thresholds (defaults in remote/alert.sh):
# REO_ALERT_REMIND_HOURS=6     reminder while something stays failing
# REO_ALERT_DISK_MAX=85        % disk used
# REO_ALERT_MEM_MIN=10         % RAM available
# REO_ALERT_5XX_MAX=30         HTTP 5xx in the last hour
# REO_ALERT_EXC_MAX=3          server exceptions in 15 min (client disconnects not counted)
# REO_ALERT_BACKUP_HOURS=26    newest backup on the VPS
# REO_ALERT_OFFSITE_DAYS=3     newest backup downloaded by the PC (0 = do not check)
# REO_ALERT_TLS_DAYS=14        certificate expiry
